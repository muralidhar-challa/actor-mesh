FROM debian:bookworm-slim AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libc6-dev libnng-dev binutils && \
    rm -rf /var/lib/apt/lists/*
COPY proxy/proxy.c /src/
COPY runtime/actor_tuple.h /src/
COPY runtime/actor_uuid.h /src/
WORKDIR /src
RUN gcc -Wall -Wextra -Os -std=c11 proxy.c -lnng -o /mesh-proxy && \
    strip /mesh-proxy

# ── Package for scratch ────────────────────────────────────────────
# Libraries from /lib/aarch64-linux-gnu/ (the actual files, not symlinks)
RUN mkdir -p /out/lib && \
    cp /mesh-proxy /out/ && \
    cp /lib/aarch64-linux-gnu/libc.so.6 /out/lib/ && \
    cp /lib/aarch64-linux-gnu/libnng.so.1 /out/lib/ && \
    cp /lib/aarch64-linux-gnu/libpthread.so.0 /out/lib/ && \
    cp /lib/aarch64-linux-gnu/libmbedtls.so.14 /out/lib/ && \
    cp /lib/aarch64-linux-gnu/libmbedx509.so.1 /out/lib/ && \
    cp /lib/aarch64-linux-gnu/libmbedcrypto.so.7 /out/lib/ && \
    cp /lib/aarch64-linux-gnu/ld-linux-aarch64.so.1 /out/lib/ && \
    echo "=== packaged ===" && ls -laR /out/

FROM scratch
COPY --from=builder /out /
EXPOSE 5556 5557 8080 8081
ENTRYPOINT ["/mesh-proxy"]
