FROM alpine:3.24 AS builder
RUN apk add --no-cache gcc musl-dev cmake make linux-headers wget

# Build NNG v1.11 from source
RUN wget -q https://github.com/nanomsg/nng/archive/refs/tags/v1.11.tar.gz -O /tmp/nng.tar.gz && \
    cd /tmp && tar xzf nng.tar.gz && cd nng-1.11 && \
    mkdir build && cd build && \
    cmake -DBUILD_SHARED_LIBS=ON -DNNG_TESTS=OFF -DNNG_TOOLS=OFF -DCMAKE_BUILD_TYPE=Release .. && \
    make -j$(nproc) && make install && rm -rf /tmp/nng*

# Build proxy
COPY proxy/proxy.c /src/
COPY runtime/actor_tuple.h /src/
COPY runtime/actor_uuid.h /src/
WORKDIR /src
RUN gcc -Wall -Wextra -Os -std=c11 proxy.c -L/usr/local/lib -lnng -o /mesh-proxy && strip /mesh-proxy

FROM alpine:3.24
COPY --from=builder /usr/local/lib/libnng.so* /usr/lib/
COPY --from=builder /mesh-proxy /
EXPOSE 5556 5557
ENTRYPOINT ["/mesh-proxy"]
