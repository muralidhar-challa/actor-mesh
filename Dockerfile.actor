FROM alpine:3.24 AS builder
RUN apk add --no-cache gcc musl-dev nng-dev lmdb-dev

# ── Actor runtime ──────────────────────────────────────────────────
COPY runtime/ /src/runtime/
WORKDIR /src
RUN gcc -Wall -Wextra -Os -std=c11 \
    runtime/main.c runtime/actor.c runtime/actor_isolation.c \
    -lnng -llmdb -o /actor && \
    strip /actor

# ── Echo handler ────────────────────────────────────────────────────
COPY handlers/echo.c /src/handlers/
RUN mkdir -p /handlers && \
    gcc -Wall -Wextra -Os -std=c11 handlers/echo.c -o /handlers/echo && \
    strip /handlers/echo

FROM alpine:3.24
RUN apk add --no-cache nng lmdb
COPY --from=builder /actor /actor
COPY --from=builder /handlers/echo /handlers/echo
EXPOSE 5556 5557
ENTRYPOINT ["/actor"]
